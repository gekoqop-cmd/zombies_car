*.pdb.meta
*.mdb.meta

# Crash reports / builds / packages
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Addressables default output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db

# Local Play-mode feature test screenshots (Editor/FeatureTests.cs)
/Screenshots/Feature_*.png
