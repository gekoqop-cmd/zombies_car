--- !u!114 &7281087816571509506
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7927828687931350179}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05f9041cda996b441bf538298dded1d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZombiCar.UI.TutorialCardsView
  m_State: {fileID: 11400000, guid: 2f3d559af3924bd4b84c276864312a30, type: 2}
  m_Group: {fileID: 1570053411577374773}
  m_Card: {fileID: 8655056367760988322}
  m_PictureBack: {fileID: 863408522524908682}
  m_Icon: {fileID: 8604324919846662762}
  m_Icon2: {fileID: 1509492543368152750}
  m_Caption: {fileID: 7046226004633993205}
  m_Title: {fileID: 1075948076836828404}
  m_Text: {fileID: 4980063660758141897}
  m_Counter: {fileID: 3086534771950296509}
  m_NextButton: {fileID: 6745023250479527181}
  m_NextLabel: {fileID: 5945980699800035091}
  m_SkipButton: {fileID: 8426341614378950286}
  m_Dots:
  - {fileID: 5082659582709743745}
  - {fileID: 3784858881346896250}
  - {fileID: 7344636269499767591}
  - {fileID: 3932817278033384372}
  - {fileID: 3482484408790368562}
  - {fileID: 4850338179948320773}
  m_Cards:
  - Title: "\u0426\u0415\u041B\u042C"
    Text: "\u041F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C 30 \u0432\u043E\u043B\u043D \u0438 \u0443\u0431\u0435\u0439 3 \u0431\u043E\u0441\u0441\u043E\u0432."
    TouchText: 
    Icon: {fileID: 21300000, guid: e3f561eaa5cd26b478159faa3310bbe2, type: 3}
    Icon2: {fileID: 21300000, guid: 880655a07fd24ae4093c015365baf677, type: 3}
    TouchIcon: {fileID: 0}
    Caption: "30 \u0412\u041E\u041B\u041D \xB7 3 \u0411\u041E\u0421\u0421\u0410"
    TouchCaption: 
    Accent: {r: 1, g: 0.8, b: 0.3, a: 1}
  - Title: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415"
    Text: "WASD \u2014 \u0438\u0434\u0442\u0438, \u043C\u044B\u0448\u044C \u2014 \u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F, \u043B\u0435\u0432\u0430\u044F \u043A\u043D\u043E\u043F\u043A\u0430 \u2014 \u0430\u0442\u0430\u043A\u0430.\n1 / 2 \u0438\u043B\u0438 \u043A\u043E\u043B\u0435\u0441\u043E \u043C\u044B\u0448\u0438 \u2014 \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043E\u0440\u0443\u0436\u0438\u0435."
    TouchText: "\u041B\u0435\u0432\u044B\u0439 \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u2014 \u0438\u0434\u0442\u0438, \u043F\u0440\u0430\u0432\u044B\u0439 \u2014 \u0446\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C.\n\u041A\u043D\u043E\u043F\u043A\u0438 \u0440\u044F\u0434\u043E\u043C \u2014 \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u0438 \u0442\u043E\u043F\u043E\u0440."
    Icon: {fileID: 21300000, guid: a54cc1d7d811b9646a27c919a59160ad, type: 3}
    Icon2: {fileID: 21300000, guid: 7d9e062ec04bdd34d893df120af6a804, type: 3}
    TouchIcon: {fileID: 21300000, guid: 1af597eac785d5243aba301e8797fd2c, type: 3}
    Caption: "WASD \xB7 \u041C\u042B\u0428\u042C \xB7 1 / 2"
    TouchCaption: "\u0414\u0416\u041E\u0419\u0421\u0422\u0418\u041A\u0418 \xB7 \u041A\u041D\u041E\u041F\u041A\u0418"
    Accent: {r: 0.45, g: 0.78, b: 1, a: 1}
  - Title: "\u041E\u0420\u0423\u0416\u0418\u0415"
    Text: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442 \u0442\u0440\u0430\u0442\u0438\u0442 \u043F\u0430\u0442\u0440\u043E\u043D\u044B. \u0422\u043E\u043F\u043E\u0440 \u0431\u044C\u0451\u0442 \u0432\u0431\u043B\u0438\u0437\u0438 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E.\n\u041F\u0430\u0442\u0440\u043E\u043D\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u0443 \u043C\u0430\u0448\u0438\u043D\u044B."
    TouchText: 
    Icon: {fileID: 21300000, guid: 7d9e062ec04bdd34d893df120af6a804, type: 3}
    Icon2: {fileID: 21300000, guid: be8dc4f62e94b584c8af65eadbe72545, type: 3}
    TouchIcon: {fileID: 0}
    Caption: "\u0410\u0412\u0422\u041E\u041C\u0410\u0422 \xB7 \u0422\u041E\u041F\u041E\u0420"
    TouchCaption: 
    Accent: {r: 0.93, g: 0.47, b: 0.13, a: 1}
  - Title: "\u041C\u0410\u0428\u0418\u041D\u0410 \u0418 \u041C\u0410\u0421\u0422\u0415\u0420\u0421\u041A\u0410\u042F"
    Text: "\u0417\u0430\u0449\u0438\u0449\u0430\u0439 \u043C\u0430\u0448\u0438\u043D\u0443: \u0437\u043E\u043C\u0431\u0438 \u0438\u0434\u0443\u0442 \u0438 \u043A \u043D\u0435\u0439.\n\u041C\u0435\u0436\u0434\u0443 \u0432\u043E\u043B\u043D\u0430\u043C\u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0439 \u0435\u0451 \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439 \u0437\u0430 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043B\u043E\u043C."
    TouchText: 
    Icon: {fileID: 21300000, guid: a2cb2863dd287e24286fbaf71b555510, type: 3}
    Icon2: {fileID: 21300000, guid: 76df019849dda0d4c8cc7e31ee85f5d2, type: 3}
    TouchIcon: {fileID: 0}
    Caption: "\u0417\u0410\u0429\u0418\u0429\u0410\u0419 \u041C\u0410\u0428\u0418\u041D\u0423"
    TouchCaption: 
    Accent: {r: 0.55, g: 0.9, b: 0.45, a: 1}
  - Title: "\u0423\u0420\u041E\u0412\u041D\u0418 \u0418 \u041A\u0410\u0420\u0422\u041E\u0427\u041A\u0418"
    Text: "\u0417\u0430 \u043E\u043F\u044B\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0448\u044C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435. \xAB\u041D\u041E\u0412\u041E\u0415\xBB \u2014 \u0442\u0430\u043A\u0443\u044E \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443\n\u0442\u044B \u0435\u0449\u0451 \u043D\u0435 \u0431\u0440\u0430\u043B. \u0412\u0437\u044F\u0442\u044B\u0435 \u0432\u0438\u0434\u043D\u044B \u0441\u043B\u0435\u0432\u0430."
    TouchText: 
    Icon: {fileID: 21300000, guid: 9bbe122f035bfa34eafc64771f65c430, type: 3}
    Icon2: {fileID: 21300000, guid: 38aa64c4c74521f4198fc8d24e8c6616, type: 3}
    TouchIcon: {fileID: 0}
    Caption: "\xAB\u041D\u041E\u0412\u041E\u0415\xBB \u2014 \u0415\u0429\u0401 \u041D\u0415 \u0411\u0420\u0410\u041B"
    TouchCaption: 
    Accent: {r: 0.62, g: 0.5, b: 1, a: 1}
  - Title: "\u0411\u041E\u0421\u0421\u042B \u0418 \u041D\u0410\u0413\u0420\u0410\u0414\u0410"
    Text: "\u0411\u043E\u0441\u0441\u044B \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 10, 20 \u0438 30 \u0432\u043E\u043B\u043D\u0435 \u2014 \u043C\u0435\u0442\u043A\u0438 \u043D\u0430 \u043F\u043E\u043B\u043E\u0441\u0435 \u0441\u0432\u0435\u0440\u0445\u0443.\n\u0417\u0430 \u043F\u043E\u0431\u0435\u0434\u0443 \u2014 \u043C\u043E\u043D\u0435\u0442\u044B \u043D\u0430 \u043A\u0435\u0439\u0441\u044B \u0438 \u0441\u043A\u0438\u043D\u044B."
    TouchText: 
    Icon: {fileID: 21300000, guid: 880655a07fd24ae4093c015365baf677, type: 3}
    Icon2: {fileID: 21300000, guid: 14541d99132200c4ca88985f4c6ada2a, type: 3}
    TouchIcon: {fileID: 0}
    Caption: "\u0412\u041E\u041B\u041D\u042B 10 \xB7 20 \xB7 30"
    TouchCaption: 
    Accent: {r: 1, g: 0.35, b: 0.3, a: 1}
  m_DotIdle: {r: 1, g: 1, b: 1, a: 0.3}
  m_NextText: "\u0414\u0410\u041B\u0415\u0415"
  m_LastText: "\u0418\u0413\u0420\u0410\u0422\u042C!"
  m_Fade: 0.2
