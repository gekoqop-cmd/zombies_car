  m_FightButton: {fileID: 4420807195364882048}
  m_Bosses:
  - Name: "\u041C\u0410\u0422\u041A\u0410"
    Accent: {r: 0.55, g: 0.95, b: 0.35, a: 1}
    Abilities:
    - Title: "\u0412\u042B\u0412\u041E\u0414\u041E\u041A"
      Text: "\u0417\u043E\u0432\u0451\u0442 \u0437\u043E\u043C\u0431\u0438 \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0435\u0431\u044F.\n\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0443\u0431\u0438 \u043C\u0435\u043B\u043E\u0447\u044C."
      Pose: {fileID: 21300000, guid: ee3127ed0da73c24287e6bd5f1ebbb39, type: 3}
      Fx: {fileID: 2800000, guid: 169de2d0dc33c7747917e4b1dca310b0, type: 3}
      FxColor: {r: 0.55, g: 1, b: 0.3, a: 0.9}
      SecondPhase: 0
    - Title: "\u041A\u0418\u0421\u041B\u041E\u0422\u0410"
      Text: "\u041F\u043B\u044E\u0451\u0442\u0441\u044F \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u0439, \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043B\u0443\u0436\u0438.\n\u041D\u0435 \u0441\u0442\u043E\u0439 \u0432 \u0437\u0435\u043B\u0451\u043D\u043E\u043C."
      Pose: {fileID: 21300000, guid: 5040d17db29f3954b9d6ef6173df19d9, type: 3}
      Fx: {fileID: 2800000, guid: 1e129dc4f63accb43827349b3573a241, type: 3}
      FxColor: {r: 0.55, g: 1, b: 0.3, a: 0.9}
      SecondPhase: 0
    - Title: "\u0420\u041E\u0419"
      Text: "\u0421\u043E \u0437\u043B\u043E\u0441\u0442\u0438 \u0437\u043E\u0432\u0451\u0442 \u0447\u0430\u0449\u0435,\n\u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0433\u043E\u043D\u0447\u0438\u043C\u0438."
      Pose: {fileID: 21300000, guid: 0c720bc124882e7488056076d0d69f54, type: 3}
      Fx: {fileID: 2800000, guid: e4a84bd2961c1934db0043394c5f3cbc, type: 3}
      FxColor: {r: 0.55, g: 1, b: 0.3, a: 0.9}
      SecondPhase: 1
  - Name: "\u0422\u0410\u0420\u0410\u041D"
    Accent: {r: 0.8, g: 0.5, b: 1, a: 1}
    Abilities:
    - Title: "\u0420\u042B\u0412\u041E\u041A"
      Text: "\u0420\u0438\u0441\u0443\u0435\u0442 \u043B\u0438\u043D\u0438\u044E \u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u043E \u043D\u0435\u0439.\n\u041E\u0442\u043E\u0439\u0434\u0438 \u2014 \u043F\u043E\u0442\u043E\u043C \u043E\u043D \u043E\u0433\u043B\u0443\u0448\u0451\u043D, \u0431\u0435\u0439!"
      Pose: {fileID: 21300000, guid: 41377062e56a746459e25ae3bc9ad34c, type: 3}
      Fx: {fileID: 2800000, guid: 55f00f04904e9634a831b8b37ffa3f72, type: 3}
      FxColor: {r: 0.8, g: 0.55, b: 1, a: 0.9}
      SecondPhase: 0
    - Title: "\u041A\u0418\u0421\u041B\u041E\u0422\u041D\u042B\u0419 \u0414\u041E\u0416\u0414\u042C"
      Text: "\u041A\u0430\u043F\u043B\u0438 \u043F\u0430\u0434\u0430\u044E\u0442 \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u0435\u0431\u044F.\n\u0423\u0445\u043E\u0434\u0438 \u0438\u0437 \u043A\u0440\u0443\u0433\u043E\u0432."
      Pose: {fileID: 21300000, guid: 82a033fe3b790b9498c4d03309a3876f, type: 3}
      Fx: {fileID: 2800000, guid: 416a8a3a73dd7464e9f0509c19276dc2, type: 3}
      FxColor: {r: 0.55, g: 1, b: 0.3, a: 0.9}
      SecondPhase: 0
    - Title: "\u0417\u0415\u041C\u041B\u0415\u0422\u0420\u042F\u0421\u0415\u041D\u0418\u0415"
      Text: "\u0411\u044C\u0451\u0442 \u043E \u0437\u0435\u043C\u043B\u044E \u2014 \u0432\u043E\u043B\u043D\u0430 \u0432\u043E\u043A\u0440\u0443\u0433.\n\u0414\u0435\u0440\u0436\u0438 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E."
      Pose: {fileID: 21300000, guid: 41377062e56a746459e25ae3bc9ad34c, type: 3}
      Fx: {fileID: 2800000, guid: d94c492e870b5054a8d42f504391d3f7, type: 3}
      FxColor: {r: 0.8, g: 0.55, b: 1, a: 0.9}
      SecondPhase: 1
  - Name: "\u0416\u041D\u0415\u0426"
    Accent: {r: 1, g: 0.55, b: 0.2, a: 1}
    Abilities:
    - Title: "\u041A\u041E\u0421\u0410"
      Text: "\u0411\u044C\u0451\u0442 \u0434\u0443\u0433\u043E\u0439 \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439\n\u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442. \u041D\u0435 \u0441\u0442\u043E\u0439 \u0440\u044F\u0434\u043E\u043C."
      Pose: {fileID: 21300000, guid: 444705af6cf88e340a1fcd83f529a58c, type: 3}
      Fx: {fileID: 2800000, guid: 6c83044b1d3c40e4f88cd21cf8a48c2b, type: 3}
      FxColor: {r: 1, g: 0.55, b: 0.15, a: 0.95}
      SecondPhase: 0
    - Title: "\u041E\u0413\u041D\u0415\u041D\u041D\u042B\u0415 \u0422\u0420\u0415\u0429\u0418\u041D\u042B"
      Text: "\u0417\u0435\u043C\u043B\u044F \u0433\u043E\u0440\u0438\u0442 \u043F\u043E \u043B\u0438\u043D\u0438\u044F\u043C.\n\u0423\u0445\u043E\u0434\u0438 \u0441 \u043B\u0438\u043D\u0438\u0439, \u043F\u043E\u043A\u0430 \u0433\u043E\u0440\u044F\u0442."
      Pose: {fileID: 21300000, guid: f78f883600f56464995479a809618495, type: 3}
      Fx: {fileID: 2800000, guid: 650b47d0ba1a37941a29fc5490f1d89d, type: 3}
      FxColor: {r: 1, g: 0.55, b: 0.15, a: 0.95}
      SecondPhase: 0
    - Title: "\u0416\u0410\u0422\u0412\u0410"
      Text: "\u0421\u0442\u0430\u0432\u0438\u0442 \u043C\u0435\u0442\u043A\u0443 \u0438 \u043F\u0440\u044B\u0433\u0430\u0435\u0442 \u043A \u0442\u0435\u0431\u0435.\n\u0411\u0435\u0433\u0438 \u043E\u0442 \u043C\u0435\u0442\u043A\u0438!"
      Pose: {fileID: 21300000, guid: 69015c8966005d946bdbf819d48eec91, type: 3}
      Fx: {fileID: 2800000, guid: d5833f0c3c113a045a5bd25151c8091b, type: 3}
      FxColor: {r: 1, g: 0.55, b: 0.15, a: 0.95}
      SecondPhase: 1
  m_KeyDelay: 1
