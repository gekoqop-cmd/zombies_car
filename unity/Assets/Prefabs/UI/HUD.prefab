  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: deeccbd66acb20b49a333e613d9ec108, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZombiCar.UI.BossIntroView
  m_Waves: {fileID: 11400000, guid: 73ea086a7dd071e4a8eff0ddb603fb56, type: 2}
  m_Group: {fileID: 1716863954543171273}
  m_Card: {fileID: 261337993549723154}
  m_PortraitBack: {fileID: 8026844205863613709}
  m_Portrait: {fileID: 410609161607909623}
  m_Header: {fileID: 813120791576073007}
  m_Title: {fileID: 7435642519685240926}
  m_Tip: {fileID: 3963761708373649511}
  m_FightButton: {fileID: 4420807195364882048}
  m_Bosses:
  - Name: "\u041C\u0410\u0422\u041A\u0410"
    Portrait: {fileID: 21300000, guid: 0c720bc124882e7488056076d0d69f54, type: 3}
    Tip: "\u0417\u043E\u0432\u0451\u0442 \u0432\u044B\u0432\u043E\u0434\u043E\u043A \u0438 \u043F\u043B\u044E\u0451\u0442\u0441\u044F \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u0439, \u0438\u0434\u0451\u0442 \u043A \u043C\u0430\u0448\u0438\u043D\u0435.\n\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0443\u0431\u0438 \u043C\u0435\u043B\u043E\u0447\u044C, \u043D\u0435 \u0441\u0442\u043E\u0439 \u0432 \u0437\u0435\u043B\u0451\u043D\u044B\u0445 \u043B\u0443\u0436\u0430\u0445,\n\u0441\u0442\u0440\u0435\u043B\u044F\u0439 \u0432 \u041C\u0430\u0442\u043A\u0443, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u0435\u0442."
    Accent: {r: 0.55, g: 0.95, b: 0.35, a: 1}
  - Name: "\u0422\u0410\u0420\u0410\u041D"
    Portrait: {fileID: 21300000, guid: 46a4dcef5e81354448c5ea925078cdf5, type: 3}
    Tip: "\u041F\u0435\u0440\u0435\u0434 \u0440\u044B\u0432\u043A\u043E\u043C \u0440\u0438\u0441\u0443\u0435\u0442 \u043B\u0438\u043D\u0438\u044E \u2014 \u043E\u0442\u0445\u043E\u0434\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.\n\u041F\u043E\u0441\u043B\u0435 \u0440\u044B\u0432\u043A\u0430 \u043E\u043D \u043E\u0433\u043B\u0443\u0448\u0451\u043D \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430: \u0431\u0435\u0439!\n\u041A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0439 \u0434\u043E\u0436\u0434\u044C \u2014 \u0443\u0445\u043E\u0434\u0438 \u0438\u0437 \u043A\u0440\u0443\u0433\u043E\u0432."
    Accent: {r: 0.8, g: 0.5, b: 1, a: 1}
  - Name: "\u0416\u041D\u0415\u0426"
    Portrait: {fileID: 21300000, guid: 69015c8966005d946bdbf819d48eec91, type: 3}
    Tip: "\u041A\u043E\u0441\u0430 \u0431\u044C\u0451\u0442 \u0434\u0443\u0433\u043E\u0439 \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u2014 \u0434\u0435\u0440\u0436\u0438 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E.\n\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B: \u0443\u0445\u043E\u0434\u0438 \u0441 \u043B\u0438\u043D\u0438\u0439, \u043F\u043E\u043A\u0430 \u043E\u043D\u0438 \u0433\u043E\u0440\u044F\u0442.\n\u0412\u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0444\u0430\u0437\u0435 \u043F\u0440\u044B\u0433\u0430\u0435\u0442 \u043A \u0442\u0435\u0431\u0435 \u2014 \u0431\u0435\u0433\u0438 \u043E\u0442 \u043C\u0435\u0442\u043A\u0438!"
    Accent: {r: 1, g: 0.55, b: 0.2, a: 1}
  m_AutoClose: 8
