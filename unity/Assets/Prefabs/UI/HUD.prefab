  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZombiCar.UI.BossIntroView
  m_Waves: {fileID: 11400000, guid: 73ea086a7dd071e4a8eff0ddb603fb56, type: 2}
  m_Group: {fileID: 1716863954543171273}
  m_Head: {fileID: 6292247489581886458}
  m_Header: {fileID: 4196443798452503594}
  m_Title: {fileID: 7430637746523996515}
  m_Cards:
  - Root: {fileID: 5638497403533679958}
    Group: {fileID: 3765150563374395200}
    Frame: {fileID: 6288561119856939054}
    PictureBack: {fileID: 716437569129908508}
